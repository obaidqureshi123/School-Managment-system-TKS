@{
    ViewData["Title"] = "Rules and Regulations";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Knowledge School</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <!-- AOS Animation Library -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
            :root {
                --primary-burgundy: #581845;
                --accent-gold: #c79c2e;
                --light-bg: #fdfbf7;
                --card-bg: #ffffff;
                --text-dark: #2c3e50;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background-color: var(--light-bg);
                color: var(--text-dark);
                overflow-x: hidden;
            }

            .header-banner {
                background: linear-gradient(135deg, var(--primary-burgundy), #7b245c);
                color: white;
                padding: 60px 0;
                border-bottom: 5px solid var(--accent-gold);
                position: relative;
            }

                .header-banner h1 {
                    font-family: 'Playfair Display', serif;
                    font-weight: 700;
                    letter-spacing: 1px;
                }

            .rule-card {
                background: var(--card-bg);
                border-radius: 12px;
                border: none;
                box-shadow: 0 10px 30px rgba(88, 24, 69, 0.08);
                transition: all 0.4s ease;
                position: relative;
                overflow: hidden;
                height: 100%;
            }

                .rule-card:hover {
                    transform: translateY(-8px);
                    box-shadow: 0 15px 35px rgba(88, 24, 69, 0.15);
                }

                .rule-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 6px;
                    height: 100%;
                    background: var(--primary-burgundy);
                    transition: background 0.3s ease;
                }

                .rule-card:hover::before {
                    background: var(--accent-gold);
                }

            .icon-box {
                width: 50px;
                height: 50px;
                background: rgba(88, 24, 69, 0.1);
                color: var(--primary-burgundy);
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                font-size: 1.25rem;
                margin-right: 20px;
                flex-shrink: 0;
                transition: all 0.4s ease;
            }

            .rule-card:hover .icon-box {
                background: var(--primary-burgundy);
                color: white;
                transform: rotate(360deg);
            }

            .rule-text {
                font-size: 1.05rem;
                line-height: 1.6;
                color: #4a5568;
                margin-bottom: 0;
            }

            .badge-number {
                position: absolute;
                top: 15px;
                right: 20px;
                font-size: 1.5rem;
                font-weight: 700;
                color: rgba(88, 24, 69, 0.05);
                font-family: 'Playfair Display', serif;
            }

            footer {
                background: var(--primary-burgundy);
                color: white;
                padding: 30px 0;
                margin-top: 60px;
                border-top: 4px solid var(--accent-gold);
            }
    </style>
</head>
<body>

    <!-- Header Banner -->
    <div class="header-banner text-center" data-aos="fade-down" data-aos-duration="1000">
        <div class="container">
            <h1 class="display-4 mb-2"><i class="fas fa-balance-scale-right me-3"></i>Rules and Regulations</h1>
            <p class="lead text-light opacity-88">Guidelines ensuring discipline, respect, and academic excellence at The Knowledge School</p>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="container py-5">
        <div class="row g-4">

            <!-- Rule 1 -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                <div class="rule-card p-4">
                    <span class="badge-number">01</span>
                    <div class="d-flex align-items-start">
                        <div class="icon-box">
                            <i class="fas fa-user-graduate"></i>
                        </div>
                        <div>
                            <p class="rule-text">Parents / Guardians are requested to see that wards attend the School in prescribed uniform, every student must be neat and clean.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rule 2 -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
                <div class="rule-card p-4">
                    <span class="badge-number">02</span>
                    <div class="d-flex align-items-start">
                        <div class="icon-box">
                            <i class="fas fa-calendar-times"></i>
                        </div>
                        <div>
                            <p class="rule-text">School is strict in the matter of Parents / Guardians must send the leave application. The Student name may be struck off from school register without information continuously 6 days obtaining leaves.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rule 3 -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300">
                <div class="rule-card p-4">
                    <span class="badge-number">03</span>
                    <div class="d-flex align-items-start">
                        <div class="icon-box">
                            <i class="fas fa-hands-helping"></i>
                        </div>
                        <div>
                            <p class="rule-text">The Education of children is joint responsibility of Parents / Guardians and School teacher. The Co-operation of Parents / Guardians will go along way in making our job effective.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rule 4 -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="400">
                <div class="rule-card p-4">
                    <span class="badge-number">04</span>
                    <div class="d-flex align-items-start">
                        <div class="icon-box">
                            <i class="fas fa-ban"></i>
                        </div>
                        <div>
                            <p class="rule-text">Student will be rusticated from the school for disobedience, objectionable moral influence, disorderly or any un-see conduct. Mobiles, Novel, Pictures, Newspapers should not be brought in the school by any student.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rule 5 -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="500">
                <div class="rule-card p-4">
                    <span class="badge-number">05</span>
                    <div class="d-flex align-items-start">
                        <div class="icon-box">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <div>
                            <p class="rule-text">Parents are requested to examine this report regularly to keep a check on the progress made by their children. They are also invited to visit the school from time to time to discuss their children progress with the principal.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rule 6 -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="600">
                <div class="rule-card p-4">
                    <span class="badge-number">06</span>
                    <div class="d-flex align-items-start">
                        <div class="icon-box">
                            <i class="fas fa-school"></i>
                        </div>
                        <div>
                            <p class="rule-text">Parents are requested not to interfere with the discipline and education methods of the school. All complains should be made direct to the principal of the school not to the class teacher.</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <p class="mb-0">&copy; 2026 The Knowledge School. All Rights Reserved.</p>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AOS Animation JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({
        once: true,
        duration: 800,
        });
    </script>
</body>
</html>