@model List<School_Managment_system.Models.Student>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Poppins:wght@500;700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --rk-bg: #0b0c0e;
        --rk-panel: #16171b;
        --rk-panel-alt: #1c1e23;
        --rk-red: #e50914;
        --rk-gold: #ffc632;
        --rk-line: #24262c;
        --rk-text-dim: #8b8d94;
        --rk-champ-glow: rgba(255, 198, 50, 0.25);
    }

    body {
        background-color: var(--rk-bg) !important;
        color: #ffffff;
        font-family: 'Poppins', 'Segoe UI', sans-serif;
    }

    .rk-num {
        font-family: 'Barlow Condensed', sans-serif;
    }

    /* ===== Top Banner ===== */
    .rk-banner {
        position: relative;
        padding: 34px 0 26px;
        text-align: center;
        background: radial-gradient(ellipse 700px 300px at 50% -60px, rgba(229,9,20,0.25), transparent 70%), linear-gradient(180deg, #17181c 0%, var(--rk-bg) 100%);
        border-bottom: 2px solid var(--rk-red);
        overflow: hidden;
    }

    .rk-org-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--rk-red);
        color: #fff;
        font-weight: 800;
        font-size: 0.72rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        padding: 5px 16px;
        border-radius: 3px;
        margin-bottom: 12px;
    }

    .rk-title {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 2.4rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0;
        line-height: 1;
    }

        .rk-title span {
            color: var(--rk-red);
        }

    .rk-subtitle {
        color: var(--rk-text-dim);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        margin-top: 6px;
    }

    /* ===== Champion Spotlight ===== */
    .champ-card {
        position: relative;
        max-width: 640px;
        margin: 28px auto 0;
        background: linear-gradient(135deg, #1d1a0c 0%, var(--rk-panel) 55%);
        border: 1px solid rgba(255,198,50,0.35);
        border-radius: 16px;
        padding: 20px 26px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 0 50px var(--rk-champ-glow);
    }

    .champ-belt {
        position: absolute;
        top: -13px;
        left: 26px;
        background: linear-gradient(90deg, var(--rk-gold), #fff2c2, var(--rk-gold));
        color: #1a1400;
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 4px 14px;
        border-radius: 3px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .champ-avatar-ring {
        width: 92px;
        height: 92px;
        flex-shrink: 0;
        border-radius: 50%;
        padding: 3px;
        background: conic-gradient(from 0deg, var(--rk-gold), #fff8e0, var(--rk-gold));
        animation: rk-spin 5s linear infinite;
    }

    .champ-avatar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid var(--rk-panel);
        display: block;
    }

    .champ-info {
        flex: 1;
        min-width: 0;
    }

    .champ-name {
        font-weight: 800;
        font-size: 1.35rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .champ-id {
        color: var(--rk-text-dim);
        font-size: 0.78rem;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .champ-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--rk-gold);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .champ-rating-box {
        text-align: center;
        flex-shrink: 0;
    }

    .champ-rating-num {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 2.6rem;
        color: var(--rk-gold);
        line-height: 1;
    }

    .champ-rating-label {
        color: var(--rk-text-dim);
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ===== Rankings Table ===== */
    .rk-table-wrap {
        max-width: 820px;
        margin: 34px auto 0;
    }

    .rk-table-head {
        display: grid;
        grid-template-columns: 60px 1fr 140px;
        padding: 0 22px 10px;
        color: var(--rk-text-dim);
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border-bottom: 1px solid var(--rk-line);
    }

    .rk-row {
        display: grid;
        grid-template-columns: 60px 1fr 140px;
        align-items: center;
        background: var(--rk-panel);
        border-bottom: 1px solid var(--rk-line);
        padding: 13px 22px;
        transition: background 0.2s ease;
        position: relative;
    }

        .rk-row:first-of-type {
            border-top-left-radius: 10px;
            border-top-right-radius: 10px;
        }

        .rk-row:last-of-type {
            border-bottom-left-radius: 10px;
            border-bottom-right-radius: 10px;
            border-bottom: none;
        }

        .rk-row:hover {
            background: var(--rk-panel-alt);
        }

        .rk-row.rk-top3 {
            background: linear-gradient(90deg, rgba(255,198,50,0.06), var(--rk-panel) 40%);
        }

    .rk-pos {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 1.5rem;
        color: #5b5d64;
    }

    .rk-top3 .rk-pos {
        color: var(--rk-gold);
    }

    .rk-fighter {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .rk-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--rk-line);
        flex-shrink: 0;
    }

    .rk-top3 .rk-avatar {
        border-color: var(--rk-gold);
    }

    .rk-fighter-name {
        font-weight: 700;
        font-size: 0.96rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .rk-fighter-id {
        color: var(--rk-text-dim);
        font-size: 0.72rem;
        font-weight: 600;
    }

    .rk-rating-cell {
        text-align: right;
    }

    .rk-rating-val {
        font-family: 'Barlow Condensed', sans-serif;
        font-weight: 800;
        font-size: 1.3rem;
        color: #fff;
    }

    .rk-rating-track {
        width: 100%;
        height: 3px;
        background: #26272d;
        border-radius: 3px;
        margin-top: 5px;
        overflow: hidden;
    }

    .rk-rating-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--rk-red), #ff5b63);
        border-radius: 3px;
    }

    .rk-top3 .rk-rating-fill {
        background: linear-gradient(90deg, var(--rk-gold), #fff2c2);
    }

    /* Empty state */
    .rk-empty {
        text-align: center;
        padding: 70px 20px;
        color: var(--rk-text-dim);
    }

        .rk-empty i {
            font-size: 2.6rem;
            color: #2c2d33;
            margin-bottom: 12px;
        }

    /* ===== Animations ===== */
    @@keyframes rk-spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 575px) {
        .rk-title {
            font-size: 1.7rem;
        }

        .champ-card {
            flex-direction: column;
            text-align: center;
            padding: 30px 20px 20px;
        }

        .rk-table-head, .rk-row {
            grid-template-columns: 40px 1fr 90px;
            padding-left: 14px;
            padding-right: 14px;
        }

        .rk-fighter {
            gap: 10px;
        }
    }
</style>

<div class="rk-banner">
    <div class="container">
        <div class="rk-org-pill"><i class="fa-solid fa-shield-halved"></i> Official Rankings</div>
        <h1 class="rk-title">STUDENT <span>RANKINGS</span></h1>
        <p class="rk-subtitle">Monthly Academic Performance &bull; Rated by Overall Score</p>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        var sorted = Model.OrderByDescending(s => s.OverallRate).ToList();
        var champ = sorted.First();

        <div class="champ-card">
            <div class="champ-belt"><i class="fa-solid fa-trophy"></i> Champion</div>

            <div class="champ-avatar-ring">
                <img class="champ-avatar-img"
                     src="@(string.IsNullOrEmpty(champ.profile) ? "https://ui-avatars.com/api/?name=" + champ.fullName + "&background=0D8ABC&color=fff" : champ.profile)"
                     alt="@champ.fullName"
                     onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@champ.fullName&background=0D8ABC&color=fff';" />
            </div>

            <div class="champ-info">
                <div class="champ-name">@champ.fullName</div>
                <div class="champ-id">ID: #@champ.Id</div>
                <span class="champ-tag"><i class="fa-solid fa-crown"></i> No. 1 Ranked Student</span>
            </div>

            <div class="champ-rating-box">
                <div class="champ-rating-num">@champ.OverallRate</div>
                <div class="champ-rating-label">Rating</div>
            </div>
        </div>
    }
</div>

<div class="container">
    @if (Model != null && Model.Count > 0)
    {
        var sorted = Model.OrderByDescending(s => s.OverallRate).ToList();

        <div class="rk-table-wrap pb-5">
            <div class="rk-table-head">
                <span>Rank</span>
                <span>Student</span>
                <span class="text-end">Rating</span>
            </div>

            @{
                int pos = 1;
            }
            @foreach (var item in sorted)
            {
                string rowCls = pos <= 3 ? "rk-row rk-top3" : "rk-row";

                <div class="@rowCls">
                    <div class="rk-pos">#@pos</div>

                    <div class="rk-fighter">
                        <img class="rk-avatar"
                             src="@(string.IsNullOrEmpty(item.profile) ? "https://ui-avatars.com/api/?name=" + item.fullName + "&background=0D8ABC&color=fff" : item.profile)"
                             alt="@item.fullName"
                             onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=@item.fullName&background=0D8ABC&color=fff';" />
                        <div class="min-w-0">
                            <div class="rk-fighter-name">@item.fullName</div>
                            <div class="rk-fighter-id">ID: #@item.Id</div>
                        </div>
                    </div>

                    <div class="rk-rating-cell">
                        <div class="rk-rating-val">@item.OverallRate</div>
                        <div class="rk-rating-track">
                            <div class="rk-rating-fill" style="width:@item.OverallRate%;"></div>
                        </div>
                    </div>
                </div>
                pos++;
            }
        </div>
    }
    else
    {
        <div class="rk-empty">
            <i class="fa-solid fa-ranking-star d-block"></i>
            <p class="mb-0 fw-semibold">No rankings available yet</p>
            <p class="small mb-0">Rankings will appear once student scores are added.</p>
        </div>
    }
</div>